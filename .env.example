PORT=3000

# Credenciales del bot de Twitch (opcionales).
# Si se dejan vacías, tmi.js se conecta en modo anónimo (justinfanXXXXX),
# suficiente para LEER el chat. Solo son necesarias si en el futuro
# el Ingestor necesita escribir en el chat (ej. banear, timeouts, etc).
TWITCH_USERNAME=
TWITCH_OAUTH_TOKEN=

# RabbitMQ: cola por donde el Ingestor publica y el Motor de Moderación consume
RABBITMQ_URL=amqp://localhost:5672
MODERATION_QUEUE=chat-messages
